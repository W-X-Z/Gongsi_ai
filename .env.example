# ── 공시 수집 (실데이터) ────────────────────────────────
# DART OpenAPI 인증키. 없으면 샘플 데이터로 동작합니다.
# 발급: https://opendart.fss.or.kr  →  인증키 신청/관리
DART_API_KEY=

# 조회 기간(일). 주말/공휴일엔 공시가 적으니 3~5로 늘려보세요.
LOOKBACK_DAYS=1

# ── 분석 ────────────────────────────────────────────────
# 피드에 노출할 최대 건수
FEED_LIMIT=20
# 1차 선별 기준 중요도 (1=낮음 이상, 2=보통 이상, 3=높음만)
MIN_IMPORTANCE=2

# ── LLM 해석 (선택) ─────────────────────────────────────
# 키가 있으면 Claude가 호재/악재/중립·요약·후속액션을 생성하고,
# 없으면 룰 기반 해석으로 자동 폴백합니다.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
# auto(키 있으면 LLM) / on(강제) / off(룰만)
USE_LLM=auto
